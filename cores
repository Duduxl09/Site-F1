/*==================================================
        CORES DAS EQUIPES F1 2026
==================================================*/


/*==================================================
        McLAREN
==================================================*/

.mclaren{
    --primary: #FF8000;
    --primary-rgba: rgba(255,128,0,1);

    --secondary: #000000;
    --secondary-rgba: rgba(0,0,0,1);
}


/*==================================================
        MERCEDES
==================================================*/

.mercedes{
    --primary: #00D2BE;
    --primary-rgba: rgba(0,210,190,1);

    --secondary: #000000;
    --secondary-rgba: rgba(0,0,0,1);

    --tertiary: #C0C0C0;
    --tertiary-rgba: rgba(192,192,192,1);
}


/*==================================================
        RED BULL
==================================================*/

.redbull{
    --primary: #1E41FF;
    --primary-rgba: rgba(30,65,255,1);

    --secondary: #1E2A44;
    --secondary-rgba: rgba(30,42,68,1);

    --tertiary: #FFD700;
    --tertiary-rgba: rgba(255,215,0,1);

    --quaternary: #0057B8;
    --quaternary-rgba: rgba(0,87,184,1);
}


